{
  "name": "flipview",
  "version": "0.5.3",
  "description": "Standalone client-side page-flip book viewer for PDFs and images: renders a document as a real turning-page book in the browser, no server, no upload.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flipview.css": "./dist/flipview.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build/css.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "pdfjs-dist": "^5.4.149",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hikashop-nicolas/flipview.git"
  },
  "homepage": "https://hikashop-nicolas.github.io/flipview/",
  "bugs": {
    "url": "https://github.com/hikashop-nicolas/flipview/issues"
  },
  "keywords": [
    "flipbook",
    "page-flip",
    "pdf",
    "viewer",
    "book",
    "pdfjs"
  ]
}
