{
  "name": "flipview",
  "version": "0.1.0",
  "description": "Standalone client-side page-flip book viewer for PDFs and images: renders a document as a real turning-page book in the browser, no server, no upload.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flipview.css": "./dist/flipview.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/flipview.css dist/flipview.css",
    "build:demo": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "page-flip": "^2.0.7"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": { "optional": true }
  },
  "devDependencies": {
    "pdfjs-dist": "^5.4.149",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
